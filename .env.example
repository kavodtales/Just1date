# API only. Direct PostgreSQL connection for migrations; pooler allowed for runtime.
NODE_ENV=development
PORT=4000
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REDIS_URL=
# Default 18; database minimum_age setting must match and cannot be below 18.
MINIMUM_AGE=18
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/settings/subscription
OPENAI_API_KEY=
OPENAI_MODEL=
SENTRY_DSN=
EXPO_ACCESS_TOKEN=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
VERIFICATION_PROVIDER_API_KEY=
# Explicit server consent/feature flag; disabled until reviewed.
AI_ENABLED=false
# Web/admin public values only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
API_URL=http://localhost:4000
# Expo public values only. Use LAN IP for physical device API connectivity.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EAS_PROJECT_ID=
# Universal links; server-only association identifiers, never fabricated.
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=
# Development seeding only. Never set in production.
TEST_SEED_PASSWORD=
# Optional staging browser tests. Use dedicated nonproduction accounts.
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
